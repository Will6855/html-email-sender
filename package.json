{
  "name": "html-email-sender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:generate && next dev",
    "build": "npm run prod:generate && next build",
    "start": "npm run prod:generate && next start",
    "lint": "next lint",
    "dev:db:push": "prisma db push --schema=./prisma/schema.dev.prisma",
    "prod:migrate": "prisma migrate deploy --schema=./prisma/schema.prod.prisma",
    "dev:generate": "prisma generate --schema=./prisma/schema.dev.prisma",
    "prod:generate": "prisma generate --schema=./prisma/schema.prod.prisma",
    "create:admin": "node --loader ts-node/esm scripts/create-admin.ts",
    "studio:dev": "prisma studio --schema=./prisma/schema.dev.prisma",
    "studio:prod": "prisma studio --schema=./prisma/schema.prod.prisma"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4.2.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "grapesjs": "^0.22.16",
    "grapesjs-preset-newsletter": "^1.0.2",
    "next": "^16.2.4",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.74.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^10.2.1",
    "eslint-config-next": "^16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  }
}
